# Copy to .envrc or source manually before running npm run start:http.
LEAST_ROOT=/absolute/path/to/your/repo
LEAST_ALLOWED_ROOTS=/absolute/path/to
LEAST_HOST=127.0.0.1
LEAST_PORT=8787
LEAST_BASH_MODE=safe
# Bash policy: off, safe (tests/build), readonly (rg/head/tail inspection), or full.
# LEAST_BASH_MODE=readonly
# Shell backend for bash tool execution: auto, cmd, powershell, bash, or wsl (default: auto).
# LEAST_SHELL_BACKEND=auto
LEAST_WRITE_MODE=handoff
# Per-file write limit (bytes). Normal write/edit/write_many item cap.
# LEAST_MAX_WRITE_BYTES=1000000
# Aggregate write_many request limit (keep below Express body limit ~20MB).
# LEAST_MAX_WRITE_MANY_BYTES=8000000
# Aggregate existing-file content retained for write_many rollback (default 64MB).
# LEAST_MAX_WRITE_MANY_ORIGINAL_BYTES=64000000
# LEAST_MAX_WRITE_MANY_FILES=200
# Optional libuv FS thread pool for batch writes (set before process start only).
# UV_THREADPOOL_SIZE=8
LEAST_TOOL_MODE=standard
# Focus the exposed surface by workflow: standard, explore, edit, review, handoff, full.
# LEAST_TOOLSET=full
# Optional background warmup indexes: files,git,package,symbols
# LEAST_WARMUP=files,git,package
# Optional performance logging and cache-friendly defaults.
# LEAST_LOG_TOOL_CALLS=1
# Comma-separated HTTP surfaces: mcp, openai, or both (default when unset: mcp,openai).
# LEAST_HTTP_PROTOCOLS=mcp,openai
# Dedicated HTTPS origin for ChatGPT widget iframes. Required for app submission.
LEAST_WIDGET_DOMAIN=https://Zykairotis.github.io
LEAST_HTTP_TOKEN=replace-with-a-long-random-token
# Require a token even for loopback binds. Non-loopback and tunnel mode require one unless explicitly overridden.
# LEAST_REQUIRE_HTTP_TOKEN=1
# LEAST_ALLOW_NO_HTTP_TOKEN=1
# LEAST_GROK_OAUTH=1
# LEAST_GROK_OAUTH_CLIENT_ID=least-grok
# LEAST_DUAL_CLIENT=1
# Multi-client mutation safety (off by default; use lease for ChatGPT + Grok on one workspace).
# LEAST_CONCURRENCY_MODE=lease
# LEAST_LOCK_LEASE_MS=600000
LEAST_CONTEXT_DIR=.ai-bridge
# Optional stable public URL mode. Quick tunnels do not keep the same hostname.
# LEAST_TUNNEL=cloudflare-named
# LEAST_PUBLIC_HOSTNAME=least.example.com
# LEAST_TUNNEL_NAME=least
# LEAST_TUNNEL=tailscale-funnel
# TAILSCALE_BIN=C:\Program Files\Tailscale\tailscale.exe
# CLOUDFLARE_TUNNEL_NAME=least
# Or use a dashboard-managed tunnel token:
# LEAST_CLOUDFLARE_TUNNEL_TOKEN_FILE=/Users/you/.least/cloudflare-tunnel-token
# CLOUDFLARE_TUNNEL_TOKEN_FILE=/Users/you/.least/cloudflare-tunnel-token
# Optional comma-separated extra block list:
# LEAST_BLOCKED_GLOBS=**/secrets/**,**/*.sqlite,**/*.db
# Output compaction and retrieval store (compact noisy tool output locally).
# LEAST_OUTPUT_MODE=compact
# LEAST_OUTPUT_STORE=1
# LEAST_OUTPUT_STORE_TTL_MS=86400000
# LEAST_OUTPUT_STORE_MAX_ITEM_BYTES=5242880
# LEAST_COMPACT_SEARCH=1
# LEAST_COMPACT_GIT_DIFF=1
# LEAST_COMPACT_SHELL=1
# LEAST_PROJECT_MEMORY=0
# When 1, enables project_memory_* tools and context_pack memory reads.
# Optional local Codex history integration. Values: off, metadata, read.
LEAST_CODEX_SESSIONS=off
# LEAST_CODEX_DIR=~/.codex

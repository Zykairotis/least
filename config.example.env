# Copy to .envrc or source manually before running npm run start:http.
LEAST_ROOT=/absolute/path/to/your/repo
LEAST_ALLOWED_ROOTS=/absolute/path/to
LEAST_HOST=127.0.0.1
LEAST_PORT=8787
LEAST_BASH_MODE=safe
LEAST_WRITE_MODE=handoff
LEAST_TOOL_MODE=standard
# Dedicated HTTPS origin for ChatGPT widget iframes. Required for app submission.
LEAST_WIDGET_DOMAIN=https://Zykairotis.github.io
LEAST_HTTP_TOKEN=replace-with-a-long-random-token
# Require a token even for loopback binds. Non-loopback and tunnel mode require one unless explicitly overridden.
# LEAST_REQUIRE_HTTP_TOKEN=1
# LEAST_ALLOW_NO_HTTP_TOKEN=1
LEAST_CONTEXT_DIR=.ai-bridge
# Optional stable public URL mode. Quick tunnels do not keep the same hostname.
# LEAST_TUNNEL=cloudflare-named
# LEAST_PUBLIC_HOSTNAME=least.example.com
# CLOUDFLARE_TUNNEL_NAME=least
# Or use a dashboard-managed tunnel token:
# CLOUDFLARE_TUNNEL_TOKEN_FILE=/Users/you/.least/cloudflare-tunnel-token
# Optional comma-separated extra block list:
# LEAST_BLOCKED_GLOBS=**/secrets/**,**/*.sqlite,**/*.db

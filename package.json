{
  "name": "least",
  "version": "0.31.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zykairotis/least.git"
  },
  "bugs": {
    "url": "https://github.com/Zykairotis/least/issues"
  },
  "homepage": "https://Zykairotis.github.io/least/",
  "keywords": [
    "mcp",
    "chatgpt",
    "codex",
    "apps-sdk",
    "least",
    "local-development",
    "cloudflare-tunnel",
    "tailscale",
    "ngrok"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "README.md",
    "README_ZH.md",
    "PUBLIC_LAUNCH_CHECKLIST.md",
    "DOMAIN_SETUP.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "FAQ.md",
    "FAQ_ZH.md",
    "CHANGELOG.md",
    "CHATGPT_PROMPT.md",
    "CODEX_PROMPT.md",
    "AGENTS.example.md",
    "config.example.env"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "least": "scripts/least.mjs",
    "least-mcp": "dist/stdio.js",
    "least-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/stdio.js",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "smoke": "node scripts/smoke.mjs && node scripts/http-smoke.mjs && node scripts/grok-oauth-smoke.mjs && node scripts/dual-client-smoke.mjs && node scripts/tailscale-funnel-smoke.mjs && node scripts/openai-smoke.mjs && node scripts/pro-smoke.mjs && node scripts/doctor-smoke.mjs && node scripts/settings-smoke.mjs && node scripts/permissions-unit.mjs && node scripts/skills-manifest-unit.mjs && node scripts/hooks-unit.mjs && node scripts/yolo-mode-unit.mjs && node scripts/execute-handoff-smoke.mjs && node scripts/workspace-locks-unit.mjs && node scripts/concurrency-lock-smoke.mjs && node scripts/fast-exploration-unit.mjs && node scripts/shell-backend-smoke.mjs && node scripts/perf-accounting-unit.mjs && node scripts/output-shaper-unit.mjs && node scripts/range-read-unit.mjs && node scripts/review-untracked-unit.mjs && node scripts/process-runner-unit.mjs && node scripts/timeout-unit.mjs && node scripts/output-store-unit.mjs && node scripts/context-ranker-unit.mjs && node scripts/gain-unit.mjs && node scripts/project-memory-unit.mjs && node scripts/minimality-review-unit.mjs",
    "benchmark:exploration": "node scripts/fast-exploration-benchmark.mjs",
    "benchmark:scale": "node scripts/perf-scale-benchmark.mjs --repo-size=small",
    "benchmark:scale:tiny": "node scripts/perf-scale-benchmark.mjs --repo-size=tiny",
    "benchmark:scale:small": "node scripts/perf-scale-benchmark.mjs --repo-size=small",
    "generate:adapters": "node scripts/generate-agent-adapters.mjs",
    "doctor": "node scripts/least.mjs doctor",
    "connect": "node scripts/least.mjs",
    "connect:setup": "node scripts/least.mjs setup",
    "connect:local": "node scripts/least.mjs --tunnel none",
    "connect:cloudflare": "node scripts/least.mjs --tunnel cloudflare",
    "connect:chatgpt": "node scripts/least.mjs --tunnel cloudflare",
    "connect:stable": "node scripts/least.mjs --tunnel cloudflare-named",
    "connect:ngrok": "node scripts/least.mjs ngrok",
    "connect:tailscale": "node scripts/least.mjs tailscale",
    "pro:bundle": "node scripts/pro-bundle.mjs",
    "pro:apply": "node scripts/pro-apply.mjs",
    "dashboard:dev": "cd web/dashboard && npx vite --config vite.config.ts",
    "dashboard:build": "cd web/dashboard && npx vite build --config vite.config.ts",
    "dashboard:typecheck": "npx tsc -p web/dashboard/tsconfig.json --noEmit",
    "dashboard:preview": "cd web/dashboard && npx vite preview --config vite.config.ts --host 127.0.0.1 --port 8922",
    "dashboard:unit": "node scripts/dashboard-unit.mjs",
    "dashboard:agent-unit": "node scripts/dashboard-agent-unit.mjs",
    "dashboard:smoke": "node scripts/dashboard-smoke.mjs",
    "dashboard:build-smoke": "node scripts/dashboard-build-smoke.mjs",
    "agent:terminal-smoke": "node scripts/agent-terminal-smoke.mjs",
    "agent:lifecycle-smoke": "node scripts/agent-lifecycle-smoke.mjs",
    "agent:start-contract-smoke": "node scripts/agent-start-contract-smoke.mjs",
    "agent:omp-windows-smoke": "node scripts/agent-omp-windows-launch-smoke.mjs",
    "agent:e2e-smoke": "node scripts/agent-e2e-smoke.mjs",
    "postinstall": "node scripts/patch-groundcrew-windows.mjs"
  },
  "dependencies": {
    "@clipboard-health/groundcrew": "^4.45.9",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "minimatch": "^10.0.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
